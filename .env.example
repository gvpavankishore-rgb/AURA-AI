# =====================================================================
# AURA AI environment variables
#
# FRONTEND (frontend/.env) - Vite reads these into the browser bundle.
#   VITE_SUPABASE_URL=      https://<your-ref>.supabase.co   (base URL, no /rest/v1)
#   VITE_SUPABASE_ANON_KEY= sb_publishable_... | eyJ...       (publishable/anon key)
#
# BACKEND (backend/.env) - keep these server-side only.
#   SUPABASE_URL=          https://<your-ref>.supabase.co   (base URL, no /rest/v1)
#   SUPABASE_ANON_KEY=     <same publishable/anon key>
#   CLIENT_URL=            http://localhost:5173
#   PORT=5001
#
#   AI_PROVIDER=openrouter
#   OPENROUTER_API_KEY=    your_openrouter_api_key_here  (https://openrouter.ai/keys)
#   OPENROUTER_MODEL=      deepseek/deepseek-chat-v3-0324:free
#   OPENROUTER_BASE_URL=   https://openrouter.ai/api/v1
#   OPENROUTER_SITE_URL=   http://localhost:5173   (sent as HTTP-Referer header)
#   OPENROUTER_APP_NAME=   AURA AI                 (sent as X-Title header)
#
# The OpenRouter API key is used server-side ONLY and is never baked into
# the frontend bundle or exposed to the browser.
#
# Auth (email/password + Google OAuth) is handled by Supabase Auth in the
# browser. The backend only VERIFIES Supabase access tokens - it no longer
# mints its own JWTs, so no JWT_SECRET is required.
#
# For Google Sign-In, configure in Supabase Dashboard:
#   Auth > Sign In / Providers > Google (client ID + secret from Google Cloud)
#   Redirect URLs: http://localhost:5173/auth/callback
#   And in Google Cloud OAuth: Authorized redirect URI
#     https://<your-ref>.supabase.co/auth/v1/callback
# =====================================================================