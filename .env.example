# =====================================================================
# AURA AI environment variables
#
# FRONTEND (frontend/.env) - Vite reads these into the browser bundle.
#   VITE_SUPABASE_URL=      https://<your-ref>.supabase.co   (base URL, no /rest/v1)
#   VITE_SUPABASE_ANON_KEY= sb_publishable_... | eyJ...       (publishable/anon key)
#
# BACKEND (backend/.env) - keep these server-side only.
#   SUPABASE_URL=          https://<your-ref>.supabase.co   (base URL, no /rest/v1)
#   SUPABASE_ANON_KEY=     <same publishable/anon key>
#   CLIENT_URL=            http://localhost:5173   (comma-separated: add your
#                            production frontend origin, e.g.
#                            http://localhost:5173,https://<frontend>.onrender.com)
#   PORT=5001
#
#   AI_PROVIDER=openrouter
#   OPENROUTER_API_KEY_1= your_primary_openrouter_key  (https://openrouter.ai/keys)
#   OPENROUTER_API_KEY_2= your_backup_openrouter_key   (optional, failover)
#   OPENROUTER_MODEL=      deepseek/deepseek-chat-v3-0324:free
#   OPENROUTER_BASE_URL=   https://openrouter.ai/api/v1
#   OPENROUTER_SITE_URL=   http://localhost:5173   (sent as HTTP-Referer header)
#   OPENROUTER_APP_NAME=   AURA AI                 (sent as X-Title header)
#
#   Live web search (optional). Enables current/live answers for weather,
#   news, latest prices, "search the web for ..." etc. Server-side only.
#   WEB_SEARCH_ENABLED=true
#   WEB_SEARCH_PROVIDER=tavily
#   TAVILY_API_KEY=        your_tavily_api_key_here (https://tavily.com)
#
#   Real-time weather (optional). Weather queries ("weather in Kavali",
#   "temperature in Hyderabad", "will it rain today?") are answered with live
#   data straight from the provider, bypassing the LLM. Server-side only.
#   WEATHER_API_KEY=       your_weather_api_key_here
#                            openweather -> https://openweathermap.org/api
#                            weatherapi  -> https://www.weatherapi.com
#   WEATHER_PROVIDER=      openweather   (or weatherapi)
#
#   Voice features (optional, need real credits):
#   OPENAI_API_KEY=        your_openai_api_key_here  -> speech-to-text
#                            (whisper-1), text-to-speech (tts-1).
#   ELEVENLABS_API_KEY=    your_elevenlabs_api_key_here  -> speech-to-text route
#                            (free plan can't use library voices via API)
#   Voice features fall back to OpenRouter /audio/* when OPENAI_API_KEY is
#   missing (requires an OpenRouter balance).
#
# The OpenRouter, Tavily, weather, OpenAI, and ElevenLabs API keys are used
# server-side ONLY and are never baked into the frontend bundle or exposed to
# the browser. Use the two-key failover so chat keeps working if one OpenRouter
# account hits its limit.
#
# Auth (email/password + Google OAuth) is handled by Supabase Auth in the
# browser. The backend only VERIFIES Supabase access tokens - it no longer
# mints its own JWTs, so no JWT_SECRET is required.
#
# For Google Sign-In, configure in Supabase Dashboard:
#   Auth > Sign In / Providers > Google (client ID + secret from Google Cloud)
#   Redirect URLs: http://localhost:5173/auth/callback
#   And in Google Cloud OAuth: Authorized redirect URI
#     https://<your-ref>.supabase.co/auth/v1/callback
# =====================================================================