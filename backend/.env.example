# AURA AI Backend Environment
# Copy this file to backend/.env and fill in real values.

# Supabase project (backend-only usage - keys are never exposed to the frontend)
# IMPORTANT: this is the PROJECT base URL, NOT https://<ref>.supabase.co/rest/v1
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# App
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# NOTE: with NODE_ENV=production the server refuses to start unless
# SUPABASE_URL, SUPABASE_ANON_KEY and OPENROUTER_API_KEY are all set.

# -----------------------------------------------------------------------------
# AI provider: OpenRouter (OpenAI-compatible API)
# Get an API key at https://openrouter.ai/keys  (server-side only - NEVER
# expose it to the frontend or commit it to git).
# -----------------------------------------------------------------------------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional app-identification headers (sent as HTTP-Referer and X-Title)
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=AURA AI

# Optional per-task model overrides (OpenRouter defaults shown)
# AI_VISION_MODEL=deepseek/deepseek-chat-v3-0324:free
# AI_IMAGE_MODEL=openai/gpt-image-1
# AI_TRANSCRIBE_MODEL=openai/whisper-large-v3
# AI_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15

# -----------------------------------------------------------------------------
# Legacy OpenAI / other OpenAI-compatible providers (OPTIONAL, backward
# compatible). Only set these if you still call a non-OpenRouter
# OpenAI-compatible endpoint. AI_API_KEY is used as a fallback when
# OPENROUTER_API_KEY is not set.
# -----------------------------------------------------------------------------
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o
# AI_IMAGE_BASE_URL=https://api.openai.com/v1
# AI_IMAGE_MODEL=dall-e-3
# AI_SPEECH_BASE_URL=https://api.openai.com/v1
# AI_TRANSCRIBE_MODEL=whisper-1
# AI_TTS_MODEL=tts-1