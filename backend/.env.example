# AURA AI Backend Environment
# Copy this file to backend/.env and fill in real values.

# Supabase project (backend-only usage - keys are never exposed to the frontend)
# IMPORTANT: this is the PROJECT base URL, NOT https://<ref>.supabase.co/rest/v1
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Supabase Storage — PRIVATE bucket that holds every uploaded attachment
# (chat images/documents, AI-enhanced images, voice memos). The bucket is never
# public; each object lives under `user-{auth.uid()}/` and is read back only
# through short-lived signed URLs. Create the bucket + policies by running
# backend/src/db/storage_setup.sql once in the Supabase Dashboard SQL editor.
SUPABASE_STORAGE_BUCKET=chat-attachments
# Signed-URL lifetime in seconds. Keep it short so a leaked link cannot
# outlive the session. Range: 60–900 recommended.
SUPABASE_STORAGE_SIGNED_URL_TTL=300

# App
PORT=5001
NODE_ENV=development
# Comma-separated list of allowed CORS origins. Keep the local dev origin and
# add your production frontend origin (the Render static site), e.g.:
#   CLIENT_URL=http://localhost:5173,https://<your-frontend>.onrender.com
# This is used for CORS preflight/credentials. Never use a bare "*" with
# authenticated requests.
CLIENT_URL=http://localhost:5173
# NOTE: with NODE_ENV=production the server refuses to start unless
# SUPABASE_URL, SUPABASE_ANON_KEY and an OpenRouter key
# (OPENROUTER_API_KEY_1, OPENROUTER_API_KEY_2 or OPENROUTER_API_KEY) are set.
#
# Proxy / TLS (Render):
#   On Render, trust proxy is enabled automatically (RENDER=true). If you run
#   behind another single-hop proxy without RENDER set, either set NODE_ENV=
#   production or opt in explicitly with TRUST_PROXY=true. Exactly one hop is
#   trusted; TRUST_PROXY=false forces it off (e.g. fully local).
# TRUST_PROXY=true

# Default IANA timezone used to answer "current time/date" questions when the
# user does not name a place (and no per-user timezone is stored). Used to
# render the server clock in the AI system prompt too.
# DEFAULT_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# AI provider: OpenRouter (OpenAI-compatible API)
# Get an API key at https://openrouter.ai/keys  (server-side only - NEVER
# expose it to the frontend or commit it to git).
# -----------------------------------------------------------------------------
AI_PROVIDER=openrouter
# Two-account failover: OPENROUTER_API_KEY_1 is the primary account, and when
# a request fails (auth, credits, rate limit, 5xx) it automatically retries
# with OPENROUTER_API_KEY_2. The legacy OPENROUTER_API_KEY still works and is
# treated as the primary key when OPENROUTER_API_KEY_1 is blank.
OPENROUTER_API_KEY_1=your_openrouter_api_key_here
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional app-identification headers (sent as HTTP-Referer and X-Title)
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=AURA AI

# -----------------------------------------------------------------------------
# Live web search (optional but recommended).
# When enabled, AURA runs a web search first for current/live questions
# (weather, news, latest prices, "search the web for ...") and
# feeds the results to OpenRouter so it answers from retrieved info.
# (Explicit "current date/time" questions are answered from the server clock
# directly and never hit the web search.)
# Get a Tavily API key at https://tavily.com  (server-side only - NEVER expose
# it to the frontend or commit it to git).
# -----------------------------------------------------------------------------
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Real-time weather (optional but recommended).
# Weather queries ("weather in Kavali", "temperature in Hyderabad", "will it
# rain today?") return live data directly (bypassing the LLM) when configured.
# Supported providers:
#   openweather  -> https://openweathermap.org/api
#   weatherapi   -> https://www.weatherapi.com
# (server-side only - NEVER expose the key to the frontend or commit it to git)
# -----------------------------------------------------------------------------
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_PROVIDER=openweather

# Optional per-task model overrides. Defaults are chosen at runtime:
# - AI_TRANSCRIBE_MODEL=openai/whisper-large-v3  (OpenRouter voice fallback)
# - AI_TTS_MODEL=tts-1                            (OpenAI / OpenRouter "openai/tts-1")
# - AI_VISION_MODEL=openai/gpt-4o-mini            (vision chat)
# Uncomment to override:
# AI_TRANSCRIBE_MODEL=whisper-1
# AI_TTS_MODEL=tts-1
# AI_VISION_MODEL=openai/gpt-4o-mini

# -----------------------------------------------------------------------------
# Voice (multimodal) — optional but improves AURA.
#
# 1) OPENAI_API_KEY (https://platform.openai.com/api-keys) — OPTIONAL, only for
#    direct-OpenAI voice features (whisper-1 speech-to-text, tts-1 text-to-
#    speech). When missing, voice falls back to OpenRouter /audio/* (requires a
#    fundable OpenRouter balance).
#
# 2) ELEVENLABS_API_KEY (https://elevenlabs.io) — text-to-speech.
#    When set, TTS routes to ElevenLabs before anything else. Free accounts
#    cannot use premade/library voices via the API; set ELEVENLABS_VOICE_ID to
#    a custom voice you own.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# -----------------------------------------------------------------------------
# Legacy OpenAI / other OpenAI-compatible providers (OPTIONAL, backward
# compatible). Only set these if you still call a non-OpenRouter
# OpenAI-compatible endpoint. AI_API_KEY is used as a fallback when
# OPENROUTER_API_KEY is not set.
# -----------------------------------------------------------------------------
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o
# AI_SPEECH_BASE_URL=https://api.openai.com/v1
# AI_TRANSCRIBE_MODEL=whisper-1
# AI_TTS_MODEL=tts-1