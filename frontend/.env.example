# AURA AI Frontend Environment (Vite)
# Copy this file to frontend/.env and fill in real values.
# Only use the SUITABLE (publishable/anon) keys here - never service_role.

# Supabase project base URL (NO /rest/v1 suffix)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# ---------------------------------------------------------------------
# Google OAuth must be ENABLED in the Supabase Dashboard, otherwise
# "Continue with Google" fails with:
#   "Unsupported provider: provider is not enabled"
#
# 1) Supabase Dashboard -> Authentication -> Sign In / Providers:
#    - Enable "Google"
#    - Create OAuth credentials at https://console.cloud.google.com (Web app)
#    - Add Authorized redirect URI:
#        https://<your-project-ref>.supabase.co/auth/v1/callback
#    - Paste Google Client ID and Client Secret into Supabase
# 2) Supabase Dashboard -> Authentication -> URL Configuration -> Redirect URLs:
#    - Add http://localhost:5173/auth/callback (and your production origin)
# 3) Restart the frontend/backend dev servers and retry.
# ---------------------------------------------------------------------